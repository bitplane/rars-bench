.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# bench-specific: never commit corpora or result DBs
corpora
!corpora/.gitkeep
results/*
!results/.gitkeep
# ...except the history store: results/<version>/<machine-id>-<tier>.json
!results/*/
results/*/*
!results/*/*-quick.json
!results/*/*-timed.json
# reference RAR binaries — copied locally, never pushed
_refs/*
!_refs/**/.gitkeep

# release bench inputs and scratch (rars-bench release)
.release/
